{
  "name": "@huanlin/dsh-plugin-komari",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "komari"
  ],
  "description": "DSH plugin exposing Komari monitoring-panel tools (list servers, run remote commands) to the model, with a settings-page card for endpoint/username/password. | DSH 插件：向模型暴露 Komari 探针工具（列机器、远程执行命令），并在设置页配置面板地址与账号。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown --config tsdown.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.5",
    "@huanlin/dsh-plugin-toolsets": "^0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@huanlin/dsh-plugin-toolsets": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-connection": "link:D:/Projects/deepseek-harness/dsh/packages/client/connection",
    "@deepseek-ai/dsh-tools": "link:D:/Projects/deepseek-harness/dsh/packages/core/tools",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
